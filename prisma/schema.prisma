generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                String   @id @default(cuid())
  country           String
  isoCode           String?
  region            String?
  name              String
  data              String
  validityDays      Int
  planType          String
  usageFit          String
  role              String
  buyPrice          Float
  sellPrice         Float
  oldPrice          Float?
  provider          String
  providerProductId String   @unique
  image             String
  description       String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions CustomerSession[]
  orders   Order[]
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model Order {
  id          String  @id @default(cuid())
  customer    String
  customerId  String?

  productId   String
  payment     String
  fulfillment String

  esimStatus      String?
  providerOrderId String?
  iccid           String?
  qrCodeUrl       String?
  activationCode  String?

  totalDataGb     Float?
  usedDataGb      Float?
  remainingDataGb Float?

  expiresAt       DateTime?
  lastUsageSyncAt DateTime?

  createdAt DateTime @default(now())

  customerAccount Customer? @relation(fields: [customerId], references: [id])
}

model ApiProvider {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  apiKey    String?
  mode      String   @default("test")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}