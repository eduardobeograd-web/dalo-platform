generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"

}


model RecommendationSetting {
  id                      String   @id @default(cuid())
  usageType               String   @unique
  label                   String

  gbPerDay                Float
  minimumGb               Float
  maxBestMatchMultiple    Float    @default(2.5)

  budgetMinNeedMultiple   Float    @default(0.5)
  comfortMinNeedMultiple  Float    @default(1.5)
  heavyMinGb              Float    @default(20)

  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  country           String
  isoCode           String?
  region            String?
  name              String
  data              String
  validityDays      Int
  planType          String
  usageFit          String
  role              String
  buyPrice          Float
  sellPrice         Float
  oldPrice          Float?
  provider          String
  providerProductId String   @unique
  image             String
  description       String

  slug              String?  @unique
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  seoText           String?

  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerEvents    CustomerEvent[]

  @@index([active, country])
  @@index([active, region])
}

model CountryNetworkCoverage {
  id          String   @id @default(cuid())
  isoCode     String   @unique
  countryName String
  networks    Json
  source      String   @default("eSIM Go")
  syncedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  passwordHash        String?
  billingCompany      String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions        CustomerSession[]
  passwordResetTokens PasswordResetToken[]
  orders          Order[]
  supportRequests SupportRequest[]
  customerEvents  CustomerEvent[]
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String? @unique
  customer    String
  customerId  String?

  productId   String
  amount      Float?
  currency    String?
  buyPriceAtPurchase Float?
  productNameAtPurchase String?
  countryAtPurchase String?
  dataAtPurchase String?
  validityDaysAtPurchase Int?
  providerAtPurchase String?
  providerProductIdAtPurchase String?
  stripeSessionId String? @unique
  stripePaymentIntentId String?
  paidAt DateTime?
  legalAcceptedAt DateTime?
  legalVersion String?
  immediateDeliveryAcceptedAt DateTime?
  immediateDeliveryVersion String?
  payment     String
  fulfillment String

  esimStatus      String?
  providerOrderId String?
  iccid           String?
  qrCodeUrl       String?
  activationCode  String?
  iosInstallUrl   String?
  androidInstallUrl String?

  totalDataGb     Float?
  usedDataGb      Float?
  remainingDataGb Float?

  expiresAt       DateTime?
  lastUsageSyncAt DateTime?

  createdAt DateTime @default(now())

  customerAccount Customer? @relation(fields: [customerId], references: [id])

  supportRequests SupportRequest[]
  customerEvents  CustomerEvent[]

  @@index([customerId, createdAt])
  @@index([customer, createdAt])
  @@index([payment, createdAt])
  @@index([fulfillment, createdAt])
  @@index([esimStatus])
  @@index([productId])
}

model SupportRequest {
  id String @id @default(cuid())

  customerId String?
  orderId    String?

  customerEmail String
  reason        String
  message       String
  status        String @default("open")

  orderNumber String?
  iccid       String?
  productName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  replies  SupportReply[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([orderId])
}

model CustomerEvent {
  id String @id @default(cuid())

  customerId String?
  orderId    String?
  productId  String?

  sessionId String?
  eventType String
  metadata  Json?

  createdAt DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([orderId])
  @@index([productId])
  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

model ProviderConfig {
  id String @id @default(cuid())

  name String
  slug String @unique
  type String

  status String @default("planned")
  active Boolean @default(true)
  priority Int @default(100)

  baseUrl String?
  apiKeyEnvName String?
  productSearchQuery String?

  fulfillmentEnabled Boolean @default(false)
  catalogueEnabled Boolean @default(false)
  usageSyncEnabled Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DestinationPage {
  id                String   @id @default(cuid())
  slug              String   @unique
  countryName       String
  displayName       String
  seoTitle          String
  seoDescription    String
  headline          String
  intro             String
  heroImage         String?
  heroImageAlt      String?
  coverageText      String?
  activationText    String?
  compatibilityText String?
  hotspotText       String?
  faq               Json?
  published         Boolean  @default(false)
  indexable         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               String   @default("READ_ONLY")
  permissions        Json
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions AdminSession[]
  auditLogs AdminAuditLog[]
  supportReplies SupportReply[]
  supportPushSubscriptions SupportPushSubscription[]

  @@index([active])
  @@index([role])
}

model SupportReply {
  id                String         @id @default(cuid())
  supportRequestId  String
  adminUserId       String
  recipientEmail    String
  subject           String
  message           String
  deliveryStatus    String         @default("pending")
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  adminUser      AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([supportRequestId, createdAt])
  @@index([adminUserId])
}

model SupportPushSubscription {
  id            String   @id @default(cuid())
  adminUserId   String
  endpoint      String   @unique
  p256dh        String
  auth          String
  userAgent     String?
  failureCount  Int      @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([resource])
  @@index([createdAt])
}
