generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                String   @id @default(cuid())
  country           String
  region            String?
  name              String
  data              String
  validityDays      Int
  planType          String
  usageFit          String
  role              String
  buyPrice          Float
  sellPrice         Float
  oldPrice          Float?
  provider          String
  providerProductId String @unique
  image             String
  description       String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  customer    String
  productId   String
  payment     String
  fulfillment String
  createdAt   DateTime @default(now())
}

model ApiProvider {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  apiKey    String?
  mode      String   @default("test")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}