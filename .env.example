# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://daloesim.com

# Optional shared password for private team-test deployments.
DALO_TEST_PASSWORD=

# SQLite is supported for a single persistent server instance.
DATABASE_URL=file:./dev.db

# Resend email delivery.
RESEND_API_KEY=re_your_api_key
DALO_EMAIL_FROM=DALO eSIM <orders@daloesim.com>
DALO_EMAIL_TEST_RECIPIENT=your-test-email@example.com
DALO_ADMIN_TEST_EMAIL=admin@daloesim.com

# Keep disabled in production. Enable only for local fulfillment testing.
DALO_AUTO_MOCK_FULFILLMENT=false

# Stripe test mode is allowed until live payments are activated.
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
