# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://daloesim.com

# Optional shared password for private team-test deployments.
DALO_TEST_PASSWORD=

# Neon/PostgreSQL pooled runtime connection and direct migration connection.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Random secret used to pseudonymize checkout rate-limit identifiers.
DALO_RATE_LIMIT_SECRET=replace_with_at_least_32_random_characters

# Resend email delivery.
RESEND_API_KEY=re_your_api_key
DALO_EMAIL_FROM=DALO eSIM <orders@daloesim.com>
DALO_EMAIL_REPLY_TO=eduardobeograd@googlemail.com
DALO_EMAIL_TEST_RECIPIENT=your-test-email@example.com
DALO_ADMIN_TEST_EMAIL=admin@daloesim.com

# Keep disabled in production. Enable only for local fulfillment testing.
DALO_AUTO_MOCK_FULFILLMENT=false
DALO_ENABLE_TEST_CHECKOUT=false

# Stripe test mode is allowed until live payments are activated.
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# eSIM provider. Do not enable automatic live fulfillment until verified.
ESIM_GO_API_KEY=
ESIM_GO_BASE_URL=
