# Public production URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://daloesim.com

# Optional shared password for private team-test deployments.
DALO_TEST_PASSWORD=

# Neon/PostgreSQL pooled runtime connection and direct migration connection.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Random secret used to pseudonymize checkout rate-limit identifiers.
DALO_RATE_LIMIT_SECRET=replace_with_at_least_32_random_characters

# Resend email delivery.
RESEND_API_KEY=re_your_api_key
DALO_EMAIL_FROM=DALO eSIM <orders@daloesim.com>
DALO_EMAIL_REPLY_TO=eduardobeograd@googlemail.com
DALO_INTERNAL_ORDER_EMAIL=eduardobeograd@googlemail.com
DALO_EMAIL_TEST_RECIPIENT=your-test-email@example.com
DALO_ADMIN_TEST_EMAIL=admin@daloesim.com

# Keep disabled in production. Enable only for local fulfillment testing.
DALO_AUTO_MOCK_FULFILLMENT=false
DALO_ENABLE_TEST_CHECKOUT=false

# Stripe test mode is allowed until live payments are activated.
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# eSIM Go provider. The key alone never enables provider calls.
ESIM_GO_API_KEY=
ESIM_GO_BASE_URL=https://api.esim-go.com/v2.5

# Safe staged rollout. Start with all flags false.
# 1. Read catalogue, compatibility, assignments and usage.
ESIM_GO_READ_ENABLED=false
# 2. Validate order payloads without buying a bundle.
ESIM_GO_VALIDATE_ENABLED=false
# 3. Accept signed provider usage/lifecycle callbacks.
ESIM_GO_WEBHOOK_ENABLED=false
# 4. LAST STEP: permits paid Stripe orders to create real provider transactions.
# This also requires the eSIM Go provider's Fulfillment switch in DALO Admin.
ESIM_GO_LIVE_FULFILLMENT_ENABLED=false
# Enable only after the first manual live transaction has been reconciled.
ESIM_GO_AUTOMATIC_FULFILLMENT_ENABLED=false
# Separate customer-facing rollout after new-eSIM fulfillment is proven.
ESIM_GO_TOP_UPS_ENABLED=false
